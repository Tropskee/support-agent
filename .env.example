# URL of the running Ori runtime, which runs every model call: ticket decisions and replies,
# and the eval's fact and faithfulness judges. `bun run up` binds this port; `bun run ori:start`
# always uses 4717.
ORI_URL=http://127.0.0.1:4717
# OpenRouter model id Ori runs ticket decisions and replies on.
ORI_MODEL=anthropic/claude-haiku-4.5
# How long to wait for one Ori turn before giving up; the ticket then escalates as an error.
ORI_TIMEOUT_MS=90000

# OpenRouter model id for the eval's yes/no fact checks. Default: anthropic/claude-haiku-4.5.
JUDGE_MODEL=
# Stronger OpenRouter model id for the eval's faithfulness judge. Default:
# anthropic/claude-sonnet-5.
FAITH_JUDGE_MODEL=

# Escalates any reply whose proposed actions add up to more than this, or that proposes a
# refund, credit or claim without an amount.
REFUND_LIMIT_USD=100
# Decisions below this confidence escalate.
CONFIDENCE_FLOOR=0.7
# Tickets run in parallel by "Run agent on all" and the eval.
RUN_CONCURRENCY=4
PORT=3000
DB_PATH=support.db
# Default: eval.db in the same directory as DB_PATH. Each eval run uses its own
# <stem>-<run id>.db (eval-7.db), removed when the run finishes; results are copied into
# support.db.
EVAL_DB_PATH=
